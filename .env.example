# Server Port & Host Configuration
PORT=3000
HOST=0.0.0.0

# Session Secret (Supports both SESSION_SECRET and FLASK_SECRET_KEY fallback)
SESSION_SECRET=traininghub-enterprise-secret-key-2026
FLASK_SECRET_KEY=traininghub-enterprise-secret-key-2026

# Database Configuration (Optional: Leave blank to use zero-setup High-Speed In-Memory Demo Mode)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=training_hub_db

# Optional AI Assistant Grounding API Key (Gemini)
# If left blank, the built-in local grounded rule-based assistant is used seamlessly
GEMINI_API_KEY=
