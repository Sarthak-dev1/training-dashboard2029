<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrainingHub | Enterprise Sign In</title>
    <meta name="description" content="Enterprise employee training management, scheduling, and learning analytics platform.">
    <link rel="stylesheet" href="/style.css">
    <script>
        // Synchronous theme initialization (Light Mode default)
        (function() {
            var theme = localStorage.getItem('th_theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark-theme');
            } else {
                document.documentElement.classList.remove('dark-theme');
            }
        })();

        // Check if already authenticated via token
        (function() {
            var token = localStorage.getItem('th_session_token');
            if (token) {
                fetch('/api/auth/verify?token=' + encodeURIComponent(token))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data && data.authenticated) {
                            window.location.replace('/dashboard?auth_token=' + encodeURIComponent(token));
                        } else {
                            localStorage.removeItem('th_session_token');
                        }
                    })
                    .catch(function() {});
            }
        })();
    </script>
</head>
<body class="login-page">
    <main class="login-card">
        <div class="brand-icon">TH</div>
        <p class="eyebrow">ENTERPRISE LEARNING & DEVELOPMENT</p>
        <h1>Welcome back</h1>
        <p class="subtitle">Sign in to your TrainingHub enterprise workspace.</p>

        <!-- Server-side alert -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" id="serverErrorAlert"><%= error %></div>
        <% } %>

        <!-- Client-side dynamic alert -->
        <div class="alert alert-error" id="clientErrorAlert" style="display: none; margin-bottom: 16px;"></div>

        <form id="loginForm" method="POST" action="/login">
            <label for="user_id">User ID</label>
            <input id="user_id" name="user_id" type="text"
                   placeholder="Enter your User ID" value="admin" required autocomplete="username">

            <label for="password">Password</label>
            <div class="password-input-wrap">
                <input id="password" name="password" type="password"
                       placeholder="Enter your password" value="Admin@123" required autocomplete="current-password">
                <button type="button" id="togglePasswordBtn" class="password-toggle-btn" aria-label="Show password" title="Show password">
                    <svg class="eye-icon eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-icon eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>

            <button type="submit" id="submitBtn">Sign In <span>→</span></button>
        </form>

        <div class="demo-note" id="demoNote">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                    Enterprise Demo Credentials:<br>
                    User ID: <strong>admin</strong> &nbsp;|&nbsp; Password: <strong>Admin@123</strong>
                </div>
                <button type="button" id="fillDemoBtn" style="background:var(--vibrant-orange); color:#FFF; border:none; border-radius:6px; padding:6px 12px; font-size:11px; font-weight:700; cursor:pointer;">
                    Auto-Fill
                </button>
            </div>
        </div>
    </main>

    <script>
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const clientAlert = document.getElementById('clientErrorAlert');
        const serverAlert = document.getElementById('serverErrorAlert');
        const fillDemoBtn = document.getElementById('fillDemoBtn');
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('password');
        const userIdInput = document.getElementById('user_id');

        // Password Show/Hide Toggle
        togglePasswordBtn?.addEventListener('click', function(e) {
            e.preventDefault();
            const isPassword = passwordInput.getAttribute('type') === 'password';
            const newType = isPassword ? 'text' : 'password';
            passwordInput.setAttribute('type', newType);

            const eyeOpen = togglePasswordBtn.querySelector('.eye-open');
            const eyeClosed = togglePasswordBtn.querySelector('.eye-closed');

            if (isPassword) {
                eyeOpen.style.display = 'none';
                eyeClosed.style.display = 'inline-block';
                togglePasswordBtn.setAttribute('aria-label', 'Hide password');
                togglePasswordBtn.setAttribute('title', 'Hide password');
            } else {
                eyeOpen.style.display = 'inline-block';
                eyeClosed.style.display = 'none';
                togglePasswordBtn.setAttribute('aria-label', 'Show password');
                togglePasswordBtn.setAttribute('title', 'Show password');
            }
        });

        // Demo Auto-Fill button
        fillDemoBtn?.addEventListener('click', function() {
            if (userIdInput) userIdInput.value = 'admin';
            if (passwordInput) passwordInput.value = 'Admin@123';
            if (clientAlert) clientAlert.style.display = 'none';
            if (serverAlert) serverAlert.style.display = 'none';
        });

        // Form submission handling
        loginForm?.addEventListener('submit', async function(e) {
            e.preventDefault();

            const user_id = userIdInput ? userIdInput.value.trim() : '';
            const password = passwordInput ? passwordInput.value : '';

            if (serverAlert) serverAlert.style.display = 'none';
            if (clientAlert) {
                clientAlert.style.display = 'none';
                clientAlert.textContent = '';
            }

            if (!user_id || !password) {
                if (clientAlert) {
                    clientAlert.textContent = 'Please enter both User ID and password.';
                    clientAlert.style.display = 'block';
                }
                return;
            }

            // UI loading state & prevent duplicate submission
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = 'Signing In...';
            }

            try {
                const response = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ user_id, password })
                });

                const data = await response.json().catch(() => null);

                if (response.ok && data && data.success) {
                    if (data.token) {
                        localStorage.setItem('th_session_token', data.token);
                    }
                    const destination = data.redirect || ('/dashboard' + (data.token ? '?auth_token=' + encodeURIComponent(data.token) : ''));
                    window.location.href = destination;
                } else {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = 'Sign In <span>→</span>';
                    }
                    // Preserve User ID on failed attempt
                    if (userIdInput) userIdInput.value = user_id;
                    const errorMsg = (data && data.error) ? data.error : 'Invalid User ID or password. Use demo login: admin / Admin@123';
                    if (clientAlert) {
                        clientAlert.textContent = errorMsg;
                        clientAlert.style.display = 'block';
                    }
                }
            } catch (err) {
                // Fall back to standard form POST if fetch fails
                loginForm.submit();
            }
        });
    </script>
</body>
</html>

